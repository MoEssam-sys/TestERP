@inherits Microsoft.AspNetCore.Components.Web.ErrorBoundary
@inject One.Shared.Services.Logging.IClientLogger ClientLogger
@inject NavigationManager Navigation

@code {
    protected override async Task OnErrorAsync(Exception exception)
    {
        await ClientLogger.LogError(
            "Unhandled interface error.",
            action: "RenderPage",
            route: "/" + Navigation.ToBaseRelativePath(Navigation.Uri),
            ex: exception);
        await base.OnErrorAsync(exception);
    }
}
