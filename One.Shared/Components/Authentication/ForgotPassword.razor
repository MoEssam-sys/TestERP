@page "/forgot-password"
@layout One.Shared.Components.Layout.AuthLayout
@using One.Domain.DTOs.Identity
@using One.Shared.Services.Platform
@inject IClientStorage ClientStorage

@if (_initializing)
{
    <div class="auth-status-card" role="status">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <p>@trgma.Checking</p>
    </div>
}
else if (_sent)
{
    <div class="auth-status-card" role="status" aria-live="polite">
        <div class="auth-status-icon">
            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Size="Size.Large" />
        </div>
        <h3>@trgma.ResetLinkSentTitle</h3>
        <p>@trgma.ResetLinkSentDescription</p>
    </div>

    <MudButton Href="@LoginRoute"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               StartIcon="@Icons.Material.Outlined.ArrowBack"
               Class="auth-primary-button mt-4">
        @trgma.BackToLogin
    </MudButton>
}
else
{
    <div class="auth-card-header">
        <h2>@trgma.ForgotPasswordTitle</h2>
        <p>@trgma.ForgotPasswordDescription</p>
    </div>

    @if (!_systemScope)
    {
        <div class="auth-context-card">
            <MudIcon Icon="@Icons.Material.Outlined.Apartment" />
            <div>
                <span>@trgma.SelectedWorkspace</span>
                <strong>@_companyName · @_companyCode</strong>
            </div>
        </div>
    }

    <EditForm Model="_model" OnSubmit="RequestResetAsync">
        <MudTextField @bind-Value="_model.Email"
                      Label="@trgma.RegisteredEmail"
                      Placeholder="name@company.com"
                      InputType="InputType.Email"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.AlternateEmail"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Disabled="_loading"
                      Class="auth-field" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="_loading"
                   StartIcon="@(_loading ? null : Icons.Material.Outlined.Send)"
                   Class="auth-primary-button mt-2">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                @trgma.SendingResetLink
            }
            else
            {
                @trgma.SendResetLink
            }
        </MudButton>
    </EditForm>

    <MudButton Href="@LoginRoute"
               Variant="Variant.Text"
               Color="Color.Primary"
               FullWidth="true"
               StartIcon="@Icons.Material.Outlined.ArrowBack"
               Class="auth-secondary-button mt-3">
        @trgma.BackToLogin
    </MudButton>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "scope")]
    public string? Scope { get; set; }

    private readonly ForgotPasswordModel _model = new();
    private bool _initializing = true;
    private bool _loading;
    private bool _sent;
    private bool _systemScope;
    private string _companyCode = string.Empty;
    private string _companyName = string.Empty;
    private string LoginRoute => _systemScope ? "/superadmin-login" : "/login";

    protected override void OnInitialized() => _localizer.InitLocalizedComponent(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _systemScope = string.Equals(Scope, "system", StringComparison.OrdinalIgnoreCase);
        if (!_systemScope)
        {
            _companyCode = await ClientStorage.GetAsync("company_code") ?? string.Empty;
            _companyName = await ClientStorage.GetAsync("company_name") ?? string.Empty;
            if (string.IsNullOrWhiteSpace(_companyCode))
            {
                _nav.NavigateTo("/onboarding");
                return;
            }
        }

        _initializing = false;
        StateHasChanged();
    }

    private async Task RequestResetAsync()
    {
        if (_loading)
            return;
        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            await _msg.PublishErrors(trgma.PleaseEnterEmail);
            return;
        }

        _loading = true;
        try
        {
            var result = await _api.PostAsync<string, PasswordResetRequestDto>(
                "api/Authentication/Password/Forgot",
                new PasswordResetRequestDto
                {
                    Email = _model.Email.Trim(),
                    CompanyCode = _systemScope ? string.Empty : _companyCode
                },
                trgma.FailedTo);
            if (result.Success)
                _sent = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
