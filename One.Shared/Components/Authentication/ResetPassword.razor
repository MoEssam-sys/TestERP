@page "/reset-password"
@layout One.Shared.Components.Layout.AuthLayout
@using One.Domain.DTOs.Identity

@if (_completed)
{
    <div class="auth-status-card" role="status" aria-live="polite">
        <div class="auth-status-icon">
            <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Large" />
        </div>
        <h3>@trgma.PasswordResetDoneTitle</h3>
        <p>@trgma.PasswordResetDoneDescription</p>
    </div>

    <MudButton Href="@LoginRoute"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               StartIcon="@Icons.Material.Outlined.Login"
               Class="auth-primary-button mt-4">
        @trgma.BackToLogin
    </MudButton>
}
else if (!HasValidLink)
{
    <div class="auth-status-card" role="alert">
        <div class="auth-status-icon">
            <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Large" />
        </div>
        <h3>@trgma.ForgotPasswordTitle</h3>
        <p>@trgma.InvalidResetLink</p>
    </div>

    <MudButton Href="@RecoveryRoute"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Class="auth-primary-button mt-4">
        @trgma.SendResetLink
    </MudButton>
}
else
{
    <div class="auth-card-header">
        <h2>@trgma.ResetPasswordTitle</h2>
        <p>@trgma.ResetPasswordDescription</p>
    </div>

    <div class="auth-context-card">
        <MudIcon Icon="@Icons.Material.Outlined.AlternateEmail" />
        <div>
            <span>@trgma.RegisteredEmail</span>
            <strong>@Email</strong>
        </div>
    </div>

    <EditForm Model="_model" OnSubmit="ResetPasswordAsync">
        <MudTextField @bind-Value="_model.NewPassword"
                      Label="@trgma.NewPassword"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                      AdornmentAriaLabel="@(_showPassword ? trgma.HidePassword : trgma.ShowPassword)"
                      OnAdornmentClick="TogglePasswordVisibility"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Disabled="_loading"
                      Class="auth-field" />

        <MudTextField @bind-Value="_model.ConfirmPassword"
                      Label="@trgma.ConfirmPassword"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Password"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Disabled="_loading"
                      Class="auth-field" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
            @trgma.PasswordRequirements
        </MudText>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="_loading"
                   StartIcon="@(_loading ? null : Icons.Material.Outlined.Save)"
                   Class="auth-primary-button">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                @trgma.ResettingPassword
            }
            else
            {
                @trgma.ResetPasswordAction
            }
        </MudButton>
    </EditForm>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "company")]
    public string? CompanyCode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordModel _model = new();
    private bool _showPassword;
    private bool _loading;
    private bool _completed;
    private bool IsSystemScope => string.IsNullOrWhiteSpace(CompanyCode);
    private bool HasValidLink =>
        !string.IsNullOrWhiteSpace(Email) &&
        !string.IsNullOrWhiteSpace(Token);
    private string LoginRoute => IsSystemScope ? "/superadmin-login" : "/login";
    private string RecoveryRoute => IsSystemScope
        ? "/forgot-password?scope=system"
        : "/forgot-password";

    protected override void OnInitialized() => _localizer.InitLocalizedComponent(this);

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task ResetPasswordAsync()
    {
        if (_loading || !HasValidLink)
            return;
        if (string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            await _msg.PublishErrors(trgma.PleaseEnterPassword);
            return;
        }
        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            await _msg.PublishErrors(trgma.PasswordsDoNotMatch);
            return;
        }

        _loading = true;
        try
        {
            var result = await _api.PostAsync<string, PasswordResetConfirmDto>(
                "api/Authentication/Password/Reset",
                new PasswordResetConfirmDto
                {
                    Email = Email!.Trim(),
                    CompanyCode = CompanyCode?.Trim() ?? string.Empty,
                    Token = Token!,
                    NewPassword = _model.NewPassword,
                    ConfirmPassword = _model.ConfirmPassword
                },
                trgma.FailedTo);
            if (result.Success)
                _completed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
