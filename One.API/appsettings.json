{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "UserConnection": "",
    "MainConnection": ""
  },
  "AllowedHosts": "*",
  "JWT": {
    "ValidAudience": "http://localhost:4200",
    "ValidIssuer": "https://localhost:7211",
    "Secret": ""
  },
  "CorsSettings": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "PermitLimit": 120,
    "LoginPermitLimit": 10,
    "OtpRequestPermitLimit": 3,
    "OtpVerifyPermitLimit": 10
  },
  "Security": {
    "RequireHttpsMetadata": true,
    "OtpPepper": ""
  },
  "Authentication": {
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "Otp": {
      "CodeLength": 6,
      "LifetimeMinutes": 5,
      "ResendCooldownSeconds": 60,
      "MaxAttempts": 5
    },
    "PasswordReset": {
      "ClientBaseUrl": "",
      "TokenMinutes": 20
    }
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Monitoring": {
    "ClientLogRetentionDays": 30,
    "ServerLogRetentionDays": 14,
    "DeleteBatchSize": 1000,
    "MaxDeleteBatchesPerRun": 10
  }
}
